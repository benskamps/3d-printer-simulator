{
  "name": "3d-printer-simulator",
  "private": true,
  "version": "1.0.0",
  "description": "A 3D printer that runs in a browser tab: real G-code, Cartesian kinematics, a solved thermal model, and every way a print goes wrong.",
  "keywords": [
    "3d-printing",
    "gcode",
    "simulator",
    "three.js",
    "webgl",
    "klipper",
    "marlin",
    "fluidd",
    "thermal-model",
    "kinematics"
  ],
  "homepage": "https://github.com/benskamps/3d-printer-simulator#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/benskamps/3d-printer-simulator.git"
  },
  "bugs": {
    "url": "https://github.com/benskamps/3d-printer-simulator/issues"
  },
  "author": "Ben Skamps (https://brokenbranch.dev)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node src/test/smoke-test.mjs",
    "verify": "npm run build && npm test && npm run smoke"
  },
  "dependencies": {
    "lucide-react": "^0.441.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.168.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/three": "^0.168.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.3",
    "vite": "^5.4.2",
    "vitest": "^2.1.1"
  }
}
